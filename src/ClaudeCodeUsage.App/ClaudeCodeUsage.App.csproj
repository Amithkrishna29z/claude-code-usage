<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClaudeCodeUsage.Core\ClaudeCodeUsage.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms gives us the tray NotifyIcon and System.Drawing, no NuGet needed. -->
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>ClaudeCodeUsage</AssemblyName>
    <RootNamespace>ClaudeCodeUsage.App</RootNamespace>
    <Product>Claude Code Usage</Product>
    <Version>1.0.0</Version>

    <!-- Single-file publish friendliness -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
