<Window x:Class="ClaudeCodeUsage.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code Usage — Settings"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <CheckBox x:Name="OfficialCheck" Content="Use official usage from Anthropic"
                  Foreground="#EEEEEE" Margin="0,0,0,2"/>
        <TextBlock Text="Shows the same session and weekly percentages as Claude Code's /usage, using the OAuth token already in .claude\.credentials.json. Uncheck to stay fully offline and use the local estimate below."
                   Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Text="Token limit (local estimate fallback)"/>
        <TextBox x:Name="LimitBox"/>
        <TextBlock Text="Only used when the official figures are unavailable. Total tokens = input + output + cache-creation + cache-read. Calibrate to your plan by watching your real peak."
                   Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Text="Window length (hours)"/>
        <TextBox x:Name="HoursBox"/>
        <TextBlock Text="Anthropic's rolling window is 5 hours. Change only if you know it differs."
                   Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Text="Claude directory (contains \projects)"/>
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DirBox" Grid.Column="0"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="6,2,0,2"
                    Padding="10,3" Click="OnBrowse"/>
        </Grid>
        <TextBlock Text="Leave empty to use %USERPROFILE%\.claude"
                   Foreground="#999999" FontSize="11" Margin="0,0,0,10"/>

        <CheckBox x:Name="StartupCheck" Content="Start with Windows" Foreground="#EEEEEE"
                  Margin="0,4,0,12"/>

        <TextBlock x:Name="ConfigPathText" Foreground="#777777" FontSize="10" TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Save" Padding="14,5" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
